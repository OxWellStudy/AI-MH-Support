# Plotting results
create_forest_plot <- function(data, outcome_name, outcome_title, sample_size, include_y_axis = TRUE) {
  plot_data <- data %>% filter(model == outcome_name)
  n_x <- 0.0825
  
  color <- case_when(
    outcome_name == "AI/LLM Use" ~ "#65C2A5",
    outcome_name == "AI/LLM Helpfulness" ~ "#FB8D62",
    outcome_name == "Unmet Needs" ~ "#8DA0CB"
  )
  
  shape <- case_when(
    outcome_name == "AI/LLM Use" ~ 16,
    outcome_name == "AI/LLM Helpfulness" ~ 17,
    outcome_name == "Unmet Needs" ~ 15
  )
  
  p <- ggplot(plot_data, aes(x = estimate, y = plot_y)) +
    geom_point(size = 2.5, color = color, shape = shape,
               data = filter(plot_data, show_point == TRUE)) +
    geom_errorbarh(aes(xmin = conf.low, xmax = conf.high),
                   height = 0.3, linewidth = 0.75, color = color,
                   data = filter(plot_data, show_point == TRUE)) +
    geom_vline(xintercept = 1, linetype = "dashed", color = "black", alpha = 0.5) +
    
    geom_text( # add subgroup ns
      data = filter(plot_data, show_point == TRUE, !is.na(n_sub)),
      aes(x = n_x, label = scales::comma(n_sub)),
      size = 3, color = "grey30"
    ) +
    annotate("text", x = n_x, y = max(term_positions$y_pos) + 1.5,
             label = "n", fontface = "bold", size = 3.2) +
    
    scale_x_log10(
      limits = c(0.0675, 32),
      breaks = c(0.125, 0.25, 0.5, 1, 2, 4, 8, 16, 32),
      labels = c(".125", ".25", ".5", "1", "2", "4", "8", "16", "32")) +
    scale_y_continuous(
      breaks = term_positions$y_pos,
      labels = if (include_y_axis) term_positions$label else rep("", nrow(term_positions)),
      expand = expansion(mult = c(0.05, 0.05))
    ) +
    labs(
      x = "aOR",
      y = "",
      title = outcome_title,
      subtitle = paste0("(n = ", sample_size, ")")
    ) +
    theme_minimal() +
    theme(
      panel.grid.major.y = element_blank(),
      panel.grid.minor = element_blank(),
      axis.text.y = if (include_y_axis) element_text(size = 12) else element_blank(),
      plot.margin = margin(t = 20, r = 15, l = 10, b = 10, unit = "pt"),
      axis.title.x = element_text(size = 10),
      axis.title.y = element_blank(),
      plot.title = element_text(size = 14, hjust = 0.5, face = "plain"),
      plot.subtitle = element_text(size = 10, hjust = 0.5, face = "italic", margin = margin(t = 2, b = 5))
    ) +
    coord_cartesian(clip = "off")
  
  return(p)
}

