#### OUTCOMES 1-3: Calculating p-values w/ profile likelihood #### 

#### Known package issue - the p-values from tidy are derived from Wald tests so do not align
  # with profile likelihood CIs calculated (see https://github.com/tidymodels/broom/issues/1074). 
   # The following code manually calculates the p-values that correspond with the CIs for each
    # of the three fitted models.

p_LR <- function(fit) {
  model <- model.matrix(fit)
  sapply(colnames(model)[-1], function(v) {
    fit0 <- glm.fit(model[, colnames(model) != v], fit$y, family = binomial())
    pchisq(fit0$deviance - fit$deviance, df = 1, lower.tail = FALSE)
  })
}

