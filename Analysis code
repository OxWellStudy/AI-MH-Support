# Outcome = Highest level of support sought in addition to AI/LLMs

# Subset to those who had sought AI/LLM support
data4 = as.data.frame(data[data$X3200f == "Ticked (Yes)",])

# Creating composite support variables according to how presented in the survey
cols_informal <- c("X2190a","X2190b","X2190c","X2190d","X2190e")
cols_semi_formal <- c("X2200a","X2200b","X2200c","X2200d","X2200e","X2200f","X2200g",
                       "X2200h","X2200i","X2200j","X2200k","X2200l","X2200m","X2200n")
cols_formal <- c("X2210a","X2210b","X2210c","X2210d","X2210e","X2210f","X2210g","X2210h","X2210i")
cols_online <- c("X3200a", "X3200b","X3200c","X3200d","X3200e","X3200g")

# Binary variables of y/n across the different categories
data4$online <- ifelse(rowSums(data4[cols_online] == "Ticked (Yes)") > 0, "Yes", "No")
data4$informal <- ifelse(rowSums(data4[cols_informal] == "Ticked (Yes)") > 0, "Yes", "No")
data4$semiformal <- ifelse(rowSums(data4[cols_semi_formal] == "Ticked (Yes)") > 0, "Yes", "No")
data4$formal <- ifelse(rowSums(data4[cols_formal] == "Ticked (Yes)") > 0, "Yes", "No")

# Creating a 'hierarchy' of support: 
  # AI only 
  # AI + other online (no informal, semiformal, or formal support)
  # AI + informal support (+/- other online; no semiformal or formal)
  # AI + semiformal support (+/- other online, informal; no formal)
  # AI + formal support (+/- any other types)

data4$othersupport <- ifelse(data4$formal=="Yes", "AI + Formal",
                             ifelse(data4$semiformal == "Yes", "AI + Semiformal",
                                    ifelse(data4$informal == "Yes", "AI + Informal", 
                                           ifelse(data4$online == "Yes", "AI + Other online", "AI only"))))

