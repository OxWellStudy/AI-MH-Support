  subgroup_n(model1, "AI/LLM Use"),
  subgroup_n(model2, "AI/LLM Helpfulness"),
  subgroup_n(model3, "Unmet Needs")
) %>%
  mutate(model = factor(model, levels = levels(results$model)))

