# Subgroup sample size for analytic samples 
subgroup_n <- function(model, model_name) {
  md <- model$model
  fvars <- names(md)[vapply(md, is.factor, logical(1))]
  purrr::map_dfr(fvars, function(v) {
    md %>%
      count(level = as.character(.data[[v]]), name = "n_sub") %>%
      mutate(base_var = v, model = model_name, .before = 1)
  })
}

